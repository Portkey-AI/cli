{
  "name": "portkey",
  "version": "1.0.0",
  "description": "The Portkey CLI — one command to set up your AI coding agent with gateway routing, MCP tools, and team skills.",
  "bin": {
    "portkey": "src/index.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node src/index.js setup",
    "mcp": "node src/index.js mcp",
    "skills": "node src/index.js skills",
    "discover": "node src/index.js discover",
    "verify": "node src/index.js verify",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "portkey",
    "claude-code",
    "anthropic",
    "ai-gateway",
    "openai",
    "codex",
    "cursor",
    "ai-agent",
    "gateway",
    "mcp",
    "agent-skills",
    "cli"
  ],
  "author": "Portkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Portkey-AI/cli"
  },
  "homepage": "https://portkey.ai/docs",
  "bugs": {
    "url": "https://github.com/Portkey-AI/cli/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
